# systemd unit for running Pass-Uno without Docker.
# Copy the uno/ folder to /opt/pass-uno, run `npm ci --omit=dev` there, then:
#   sudo cp deploy/pass-uno.service /etc/systemd/system/
#   sudo systemctl enable --now pass-uno
[Unit]
Description=Pass-Uno game server
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/pass-uno
ExecStart=/usr/bin/node server.js
Environment=PORT=8080
Environment=DATA_DIR=/var/lib/pass-uno
StateDirectory=pass-uno
DynamicUser=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
